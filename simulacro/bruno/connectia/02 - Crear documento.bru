meta {
  name: 02 - Crear documento
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/admin/documents
  body: json
  auth: none
}

body:json {
  {
    "title": "Documento de prueba Bruno"
  }
}

script:post-response {
  const data = res.getBody();
  bru.setVar("documentId", data.data.id);
}

assert {
  res.status: eq 201
}
